# Copy to .env.production (never commit it) and fill in. Use long random values: openssl rand -base64 24
DOMAIN=portal.example.com
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Paystack secret key (sk_live_…). Online deposits stay off until it is set.
PAYSTACK_SECRET_KEY=
SESSION_TTL_HOURS=12
