# Owner connection: runs migrations, owns tables (never used for request handling)
DATABASE_OWNER_URL=postgres://giddy_owner:change-me@localhost:5432/giddy
# App connection: used for every request; subject to row-level security
DATABASE_APP_URL=postgres://giddy_app:change-me@localhost:5432/giddy
PORT=4000
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5173
# Public booking pages: the address guests use (Paystack returns them here after paying)
PUBLIC_URL=http://localhost:5173
# Paystack secret key (sk_test_… for testing, sk_live_… in production). Leave empty in development to use the
# test gateway below. Production refuses to start online payments without it.
PAYSTACK_SECRET_KEY=
# Development only: a built-in test gateway (no money moves) when there is no Paystack key. Never in production.
PAYMENTS_TEST_MODE=true
